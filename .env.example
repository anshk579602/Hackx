# Backend / API Settings
PROJECT_NAME="HackJudge (VeriJudge AI)"
API_V1_STR="/api"
SECRET_KEY="super-secret-jwt-key-verijudge-ai-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEMO_MODE=True

# Database Connection (SQLite async default, or PostgreSQL for production/docker)
# SQLite:
DATABASE_URL="sqlite+aiosqlite:///./hackjudge.db"
# PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://hackjudge:hackjudge_secret@localhost:5432/hackjudge"

# AI Provider Configuration ('mock', 'openai', 'gemini')
AI_PROVIDER="mock"
AI_API_KEY=""

# Polygon Blockchain Anchoring
BLOCKCHAIN_NETWORK="Polygon Amoy (Testnet)"
POLYGON_AMOY_RPC="https://rpc-amoy.polygon.technology/"
ANCHOR_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
ANCHOR_WALLET_PRIVATE_KEY=""

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
PORT=3000
